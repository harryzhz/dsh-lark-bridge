{
  "name": "dsh-lark-bridge",
  "version": "0.3.0",
  "description": "Lark (Feishu) multi-agent bridge, group governance, Dreaming offline memory & proactive assistant plugin for DeepSeek Harness (Desktop & Web)",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "./icon.svg",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "lark",
    "feishu",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "main": "./dist/index.js",
  "bin": {
    "lark-bridge": "./dist/lark-bridge.mjs"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/client.js",
    "dist/lark-bridge.mjs",
    "skills/lark-bridge/SKILL.md",
    "docs/assets/architecture.png",
    "docs/assets/routing-flow.png",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "build": "pnpm -r --stream build && node scripts/prepare-root.mjs",
    "build:bundle": "node scripts/prepare-root.mjs",
    "pack:bundle": "node scripts/pack-bundle.mjs",
    "prepare": "node scripts/prepare-root.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "typecheck": "pnpm -r --stream typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "pnpm -r --stream clean && node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\""
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.73.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-brand": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
